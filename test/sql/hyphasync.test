# 3e. NAME_TRUNCATED (SafeTruncateIdent) — pure C++ logic, covered by
#     test/integration/run.sh. No DuckDB-only SQL equivalent to add here.

# 3f. TYPE_COERCE — TIMESTAMP_S/MS/NS mapping.
# DuckDB supports TIMESTAMP_S/MS/NS as valid column types; the extension must
# not crash or emit a type-mapping error when it encounters them in the catalog.
statement ok
CREATE TABLE _hypha_test_ts_variants (
    id INTEGER PRIMARY KEY,
    ts_s TIMESTAMP_S,
    ts_ms TIMESTAMP_MS,
    ts_ns TIMESTAMP_NS
);

statement ok
DROP TABLE _hypha_test_ts_variants;

# 3g. hypha_help — base_snapshot and sync descriptions include key tokens.
# Verifies the help table entry contains the TABLE return-type annotation and
# the canonical usage snippet so documentation drift is caught immediately.
query I
SELECT hypha_help('hypha_base_snapshot') LIKE '%TABLE%';
----
true

# In SQL LIKE, '*' is a literal character (not a wildcard), so this matches the
# literal string "SELECT * FROM" that appears in the hypha_sync help entry.
query I
SELECT hypha_help('hypha_sync') LIKE '%SELECT * FROM%';
----
true

# hypha_init return type — after Task 1 this changed from BOOLEAN to VARCHAR.
# Verify the catalog declares VARCHAR for all overloads.
query I
SELECT COUNT(*) > 0 FROM duckdb_functions() WHERE function_name = 'hypha_init' AND return_type = 'VARCHAR';
----
true

